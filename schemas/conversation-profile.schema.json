{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/conversation-profile.schema.json",
  "title": "DSH conversation profile",
  "type": "object",
  "required": ["id", "agentPreset"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "agentPreset": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "description": "Active capability IDs for this profile. Absent = legacy unrestricted exposure.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "promptPolicy": {
      "type": "object",
      "properties": {
        "platformPrompts": { "type": "boolean" },
        "ownsSystemPrompt": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "toolPolicy": {
      "type": "object",
      "properties": {
        "ownsTools": { "type": "boolean" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
